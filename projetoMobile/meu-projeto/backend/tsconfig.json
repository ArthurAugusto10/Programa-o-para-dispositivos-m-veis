{
  "compilerOptions": {
    /* Configurações Básicas */
    "target": "ES6",                               
    "module": "CommonJS",                           
    "moduleResolution": "node",                     
    "rootDir": "./src",                             
    "outDir": "./dist",                             
    
    /* Rigor e Segurança */
    "strict": true,                                 
    "esModuleInterop": true,                        
    "skipLibCheck": true,                           
    "forceConsistentCasingInFileNames": true,       
    
    /* Ajustes para Versões Recentes (TS 5.x / 6.x) */
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}